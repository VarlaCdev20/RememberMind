                this.modal = nombre;
                this.recordData = data || {};
                this.isEditing = edit;
                this.isViewing = view;
            },
            cerrar() { 
                this.modal = null;
                this.recordData = {};
                this.isEditing = false;
                this.isViewing = false;
            }
