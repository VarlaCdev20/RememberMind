															}
														}
													],
													"documentation": "CU-18 · HU-23\nHU-23. El familiar solo consulta información expresamente habilitada. El acceso al expediente clínico permanece reservado.\nReglas y pasos del proceso: Identificar al residente vinculado; Verificar el vínculo familiar; Comprobar el permiso vigente; Mostrar solo la información autorizada.\n\nActores\nFamiliar vinculado autorizado: Familiar con cuenta activa y vínculo vigente con el residente. Consulta únicamente la información habilitada.\n\nRecorrido del caso\n1. Seleccionar un residente vinculado\n2. Verificar vínculo familiar y autorización vigente\n3. Consultar el resumen habilitado para el familiar"
												},
												{
													"_type": "UMLUseCase",
													"_id": "38949c4bce8b428ca1ebfc416895789b",
													"_parent": {
														"$ref": "891057b7071947e1ade14a3c7724124b"
													},
													"name": "Seleccionar un residente vinculado",
													"documentation": "CU-18 · HU-23\nHU-23. El familiar solo consulta información expresamente habilitada. El acceso al expediente clínico permanece reservado.\n\nCaso base: Consultar información del residente."
												},
