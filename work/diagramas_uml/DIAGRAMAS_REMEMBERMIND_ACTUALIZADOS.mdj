									},
									"name": "CU-10. GESTIONAR PRESCRIPCIONES MÉDICAS",
									"ownedElements": [
										{
											"_type": "UMLUseCaseDiagram",
											"_id": "c0f54fe6b4844b88abedc5fd22f8fff6",
