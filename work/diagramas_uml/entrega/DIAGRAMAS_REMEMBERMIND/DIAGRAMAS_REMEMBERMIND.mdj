                  },
                  "name": "CU-06. GESTIONAR ACTIVIDADES Y VISITAS",
                  "ownedElements": [
                    {
                      "_type": "UMLUseCaseDiagram",
                      "_id": "d65ccd1096a84bd4ad658d2f43728788",
